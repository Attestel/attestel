# Paper-trading validation service. Runs with ZERO config/keys. SIMULATION ONLY — it opens/closes
# simulated positions from the validated signal and compares live paper results to the backtest. It
# executes nothing, integrates no broker, and moves no money.

PORT=8097

# Upstreams (read the signal + a fresh quote; record trades in the journal). Defaults target local
# dev; docker-compose overrides with the in-network hostnames.
PREDICTION_URL=http://localhost:8003
ANALYSIS_URL=http://localhost:8001
JOURNAL_URL=http://localhost:8096

# Which (ticker:timeframe:horizon) configs the engine auto-papers on the validated signal.
CONFIGS=NVDA:1D:5,GOOGL:1D:5,TSLA:1D:5

# How often the engine evaluates (opens due signals / closes matured positions).
EVAL_INTERVAL=5m

# The simulated book's opening balance (docs/PAPER_EXECUTION_CONTRACT.md §5.2). FAKE MONEY: there is
# no account, no broker and no balance anybody can withdraw. Positions are sized equity/N — an equal-
# weight 1/N slice across the enabled configs, mirroring the evaluator's portfolio — so the live book
# and the offline evaluation keep score the same way. Returns are scale-free, so this number changes
# no statistic the service reports.
PAPER_STARTING_CASH=100000

# Where engine state AND the fake-money book are persisted. Volume in docker. Holds state.json
# (positions, bar cursors, decisions), ledger.json (the book's fast-path cache) and the APPEND-ONLY
# fills.jsonl + snapshots.jsonl the book is reconstructable from after a crash (contract §5.7).
# Losing this directory loses the book's history, not just its cache.
DATA_DIR=./data/paper

# TESTING/DEMO ONLY, REDEFINED. It is no longer a bar LENGTH — bar identity comes from the analysis
# service's own bar timestamps (docs/PAPER_EXECUTION_CONTRACT.md §2). When > 0, every EVAL_INTERVAL
# tick is counted as a new bar AND the bar-completeness check is bypassed, so a demo can fast-forward.
# 0 is the default and the only correct production value: real, COMPLETED bars only.
PAPER_BAR_SECONDS=0

# Freshness gates (contract §4, gate 2). Sessions are approximated by counting weekdays, which
# over-counts across holidays — i.e. it declares data stale slightly early, which is the correct
# direction to be wrong in.
PAPER_MAX_BAR_AGE_SESSIONS=3
PAPER_MAX_MODEL_AGE_SESSIONS=10

# The shared session secret. It does TWO jobs here and neither is optional in a real deployment:
#   1. the engine SIGNS a short-lived session for its system user so the journal accepts the
#      simulated trades it records (D-20 interim (a)); with no secret the journal answers 401 and
#      `book.recording` reports false;
#   2. this service VERIFIES the same cookie on its two MUTATING routes — POST /paper/reset (which
#      deletes every paper trade) and POST /paper/config (which rewrites what the engine trades).
# With no AUTH_SECRET those two routes are CLOSED (403, naming this variable). GET routes stay
# public. Empty by default so the stack still runs with zero configuration.
AUTH_SECRET=
COOKIE_NAME=nvda_session

# The DEDICATED SYSTEM USER the engine's simulated trades are recorded as. Never a person's id: this
# book belongs to the platform's validation harness and the UI must say so.
PAPER_SYSTEM_UID=paper-engine

# Exact allow-list of browser origins for the two MUTATING routes, comma-separated. EMPTY BY DEFAULT,
# which means NO CORS headers at all — correct for a service every shipped deployment reaches
# same-origin. It replaces `Access-Control-Allow-Origin: *`, which browsers forbid alongside
# credentials: the wildcard advertised access the authenticated POSTs could never actually be given.
# Example: CORS_ORIGINS=http://localhost:5173,http://localhost:4173
CORS_ORIGINS=
