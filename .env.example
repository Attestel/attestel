# ─────────────────────────────────────────────────────────────────────────────
# ROOT .env  —  this is the file docker-compose reads for ${VAR} substitution.
#
#   cp .env.example .env   then fill in your keys, then:  docker compose up -d --force-recreate
#
# IMPORTANT: the per-service services/*/.env files are NOT used by docker-compose.
# For `docker compose up`, keys MUST live HERE (or be exported in your shell). This root file
# is the single source of truth for every service.
# ─────────────────────────────────────────────────────────────────────────────

# --- Price data (analysis service) ---
# All OPTIONAL. With NONE set, the analysis service uses yfinance (Yahoo, no account/key) for REAL
# prices; you only get the SYNTHETIC ~$162 seed + "SYNTHETIC price data" banner when there's no
# network. Provider order: Alpaca → Twelve Data → yfinance → Tiingo (1D) → synthetic.
#
# Alpaca free "Basic"/IEX — intraday + daily bars + live quote. Requires broker KYC (it's a
# brokerage); skip unless you already have an account.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Twelve Data — official, EMAIL-ONLY signup (no KYC), free 800 req/day, intraday + daily.
TWELVEDATA_API_KEY=
# optional daily-EOD fallback (1D only)
TIINGO_API_KEY=

# --- PostgreSQL (required by the all-in-one image) ---
# Production/managed deployments provide this single URL. Durable application records remain
# isolated in service-owned schemas. The per-service URLs below are optional split overrides.
DATABASE_URL=postgresql://attestel:attestel@localhost:55432/attestel_events

# --- Experiment/account durable stores ----------------------------------------------------------
PREDICTION_DATABASE_URL=
PREDICTION_DATABASE_SCHEMA=prediction
LLM_DATABASE_URL=
LLM_DATABASE_SCHEMA=llm
JOURNAL_DATABASE_URL=
JOURNAL_DATABASE_SCHEMA=journal
PAPER_DATABASE_URL=
PAPER_DATABASE_SCHEMA=paper
ALERTS_DATABASE_URL=
ALERTS_DATABASE_SCHEMA=alerts
FEEDBACK_DATABASE_URL=
FEEDBACK_DATABASE_SCHEMA=feedback
AUTH_DATABASE_URL=
AUTH_DATABASE_SCHEMA=auth

# --- Point-in-time bar store (analysis service :8001, D-26) ---
# PostgreSQL is the only backend. BARS_DATABASE_URL is an optional split-service override;
# otherwise the service uses DATABASE_URL. Bars live in their own schema and synthetic bars are
# never persisted.
BARS_DATABASE_URL=
BARS_DATABASE_SCHEMA=analysis
BARS_DB_CONNECT_TIMEOUT=10
BARS_DB_STATEMENT_TIMEOUT_MS=15000
# Extra connect attempts (0.3s/0.7s apart, max 2) when PostgreSQL refuses or drops the first one —
# absorbs the managed cluster's observed seconds-long flaps instead of surfacing them as 500s.
# 0 disables. Worst case adds ~1s before the error propagates as before.
BARS_DB_CONNECT_RETRIES=2
# Daily bars persist permanently; intraday bars are swept after this many days.
INTRADAY_RETENTION_DAYS=90

# --- Fundamentals / news (gateway) ---
ALPHAVANTAGE_API_KEY=
MARKETAUX_API_KEY=
# SEC EDGAR needs no key, just a real contact UA
SEC_USER_AGENT=NVDA-Platform/0.1 (you@example.com)

# --- Global event corpus (events service :8004, D-26) ---
# PostgreSQL is the only event-store backend. EVENTS_DATABASE_URL is an optional split-service
# override; otherwise the service uses DATABASE_URL.
EVENTS_DATABASE_URL=
EVENTS_DATABASE_SCHEMA=public
EVENTS_DB_CONNECT_TIMEOUT=10
EVENTS_DB_STATEMENT_TIMEOUT_MS=15000
# Extra connect attempts (0.3s/0.7s apart, max 2) when PostgreSQL refuses or drops the first one —
# same flap absorber as BARS_DB_CONNECT_RETRIES. 0 disables.
EVENTS_DB_CONNECT_RETRIES=2
# How long boot keeps retrying a PostgreSQL that is not up yet (exponential backoff, capped at 15s).
# When the budget runs out the service comes up ANYWAY in a schema-not-ready state and /health says
# so — it no longer exits, exhausts supervisord's startretries and stays FATAL after the database
# returns. The first /health poll that reaches PostgreSQL completes the migration in-process.
EVENTS_DB_BOOT_RETRY_SECONDS=120
# D-29 retention, per source tier (official is indefinite and has no knob).
RETENTION_PROFESSIONAL_DAYS=400
RETENTION_DISCUSSION_DAYS=90
# D-25: background LLM enrichment. OFF by default; never triggered by a UI event (invariant #4).
EVENT_ENRICH_ENABLED=false
# Wave 2B enrichment worker knobs. Read at call time; all optional. The worker is a SINGLE bounded
# pass invoked by `make enrich-once` and exits — there is no interval here by design (§9.22).
# ENRICH_LAG_HOURS is §9.12's cutoff offset: an event is enriched as of publishedAt + this many
# hours, so a backlog event never sees events that happened after it.
ENRICH_BATCH_SIZE=5
ENRICH_LAG_HOURS=24
ENRICH_MAX_PER_RUN=25
ENRICH_IDLE_SECONDS=30
# Deterministic stale-thesis detection and its separate model worker. Both are OFF by default.
# The monitor writes markers/jobs only; `make resynth-once` runs one bounded worker pass under the
# model lease. Repetition belongs to an external scheduler, never a UI or service polling loop.
THESIS_MONITOR_ENABLED=false
THESIS_MONITOR_INTERVAL=15m
THESIS_RESYNTH_ENABLED=false
THESIS_RESYNTH_BATCH_SIZE=5
# Ingestion is a batch job, not a page load. OFF by default alongside enrichment.
INGEST_ENABLED=false

# Discovery Scout is company-level research triage, not a signal or recommendation. Both lanes are
# model-free and off by default. `scout-intake` rotates a small batch through its closed keyless
# provider allowlist; `scout` ranks only stored evidence and historical-only analysis context.
SCOUT_INGEST_ENABLED=false
SCOUT_ENABLED=false
SCOUT_UNIVERSE=NVDA,GOOGL,TSLA,AAPL,MSFT,AMZN,META,AMD,AVGO,NFLX,JPM,V,MA,COST,PEP,KO,XOM,CVX,UNH,JNJ,WMT,HD,PG,DIS,BA,CAT,CRM,ORCL,ADBE,QCOM
SCOUT_INTAKE_PROVIDERS=google-news-rss
SCOUT_INTAKE_BATCH_SIZE=5
SCOUT_INTAKE_SLOT_SECONDS=14400
SCOUT_MAX_BAR_AGE_DAYS=7
SCOUT_MAX_RUN_AGE_SECONDS=43200

# Early Opportunity Radar is a separate, completed-daily-bar research lane. It is model-free,
# rejects synthetic/stale histories, and reports late moves as extended/no-chase. OFF by default.
OPPORTUNITY_RADAR_ENABLED=false
OPPORTUNITY_BENCHMARK=SPY
OPPORTUNITY_MAX_BAR_AGE_DAYS=7
OPPORTUNITY_MAX_RUN_AGE_SECONDS=604800

# ── AUTOMATION (Phase 1) ────────────────────────────────────────────────────────────────────────
#
# The eight one-shot jobs above (including Scout and Opportunity Radar) can be driven as a single
# bounded, opt-in background workflow. Two
# flags must BOTH be true before a lane runs: this master flag AND the lane's own flag above.
# Automation is not a second way to switch a job on.
#
# `make automate-once` evaluates every lane once and exits. Production can also run a dedicated
# clock for ONLY the model-free, events-owned lanes (`ingest`, `reactions`, `scout-intake`,
# `scout`, `opportunity-radar`). It cannot import or
# dispatch `enrich` or `resynth`: invariant #4 forbids a model call caused by a scheduler tick.
# Keep the clock off for local/manual operation; the all-in-one production image supervises it.
AUTOMATION_ENABLED=false
# Separate process clock for model-free events lanes only. Both this flag and the ordinary
# gates above are required. The poll only checks due state; per-lane intervals govern executions.
PRODUCTION_SCHEDULER_ENABLED=false
PRODUCTION_SCHEDULER_POLL_SECONDS=60
# Optional allowlist. Empty means "every lane whose own flag is true". Comma-separated, from:
#   ingest, reactions, scout-intake, scout, opportunity-radar, enrich, resynth, thesis-monitor
AUTOMATION_LANES=
# Per-lane minimum interval, in seconds. These are the authoritative execution cadences.
AUTOMATION_INTERVAL_INGEST=3600
AUTOMATION_INTERVAL_ENRICH=1800
AUTOMATION_INTERVAL_RESYNTH=3600
AUTOMATION_INTERVAL_THESIS_MONITOR=900
AUTOMATION_INTERVAL_REACTIONS=21600
AUTOMATION_INTERVAL_SCOUT_INTAKE=14400
AUTOMATION_INTERVAL_SCOUT=14400
AUTOMATION_INTERVAL_OPPORTUNITY_RADAR=14400
# How long a lane lease is held before it is considered abandoned and may be re-taken. A dispatcher
# killed mid-run releases its lane after this; its orphaned run is then reconciled to `failure`,
# never left `running` and never silently promoted to success. Capped at 6h.
AUTOMATION_LEASE_SECONDS=900
# Direct official FOMC calendar ingestion. OFF by default so an empty environment opens no socket.
FEDERAL_RESERVE_ENABLED=false

# ── PHASE 2: DIRECT OFFICIAL CALENDAR SOURCES ───────────────────────────────────────────────────
#
# All three are KEYLESS, which is exactly why each has its own gate read with NO DEFAULT: with a
# default, an empty `.env` would open a socket nobody asked it to open (§9.42). All three also
# require EVENTS_CONTACT_UA below, like every other keyless provider writing to the corpus.
#
# BLS  — the Bureau of Labor Statistics' own release schedule: CPI, PPI, Employment Situation
#        (nonfarm payrolls) and the Employment Cost Index, with the agency's published reference
#        period and release time. Outranks FRED, which redistributes the same releases.
BLS_ENABLED=false
# BEA  — the Bureau of Economic Analysis' own release schedule: GDP and Personal Income & Outlays
#        (PCE). Same rules, same precedence.
BEA_ENABLED=false
# COMPANY IR — the company's OWN investor-relations events feed. This is what upgrades a tentative
#        aggregator earnings date to a confirmed one; the prior date is kept in revision history.
#        Coverage is DATA, not code: see COMPANY_IR_REGISTRY_PATH.
COMPANY_IR_ENABLED=false
# Optional JSON file adding or correcting company IR sources without a code change. Entries replace
# a built-in of the same ticker wholesale. A company that appears in NEITHER is reported as missing
# coverage (`GET /ir/coverage`, `company-ir:no-coverage`) — never served a guessed date.
#   [{"ticker":"ACME","company":"Acme Industries",
#     "feedUrl":"https://investors.example.com/events.ics","feedKind":"ics",
#     "timezone":"America/New_York","eventKinds":["earnings"]}]
COMPANY_IR_REGISTRY_PATH=
# ── PHASE 3: EVENT RELATIONSHIPS ────────────────────────────────────────────────────────────────
#
# Which companies a scheduled event bears on, and why. Every relationship carries its own provenance
# — `derived` (from the event's own fields), `reference` (a stored, cited relationship) or
# `evidence` (an official document). There is no model-generated relationship and no fourth source.
#
# Optional JSON file adding reference relationships without a code change. Entries are APPENDED to
# the built-ins. A malformed entry — no reason, no citation, or a type outside the closed
# vocabulary (direct, sector, supplier, customer, competitor, macro, factor) — is dropped whole.
#   [{"subject":"ACME","counterparty":"WIDGET","relationship":"supplier",
#     "reason":"Widget Co supplies Acme's primary component.",
#     "sourceRef":"2026 supplier disclosure","band":"primary"}]
RELATIONSHIP_REGISTRY_PATH=

# ── PHASE 4: POST-EVENT REACTIONS AND EMPIRICAL SENSITIVITY ─────────────────────────────────────
#
# Records what the market did after a stored event, from STORED BARS ONLY, and aggregates the
# matured ones. Off by default like every other background job; run by the `reactions` automation
# lane (see AUTOMATION_* above) or directly.
#
# Nothing here can display a percentage until the evidence exists. Below REACTION_MIN_SAMPLE
# matured, non-synthetic observations the aggregate returns "insufficient history" and NO statistic
# at all — not a rounded one, not a greyed-out one. A percentage on a screen is acted on whatever
# is printed beside it.
REACTION_CAPTURE_ENABLED=false
# (event, ticker) pairs examined per bounded pass.
REACTION_CAPTURE_LIMIT=100
# The sample floor. 12 is three years of quarterly earnings, or a year of monthly macro prints. It
# is not a statistical guarantee and is not presented as one; it is the point below which a median
# misleads more than it informs. Raising it is a one-line, reviewable decision.
REACTION_MIN_SAMPLE=12
# How many 8-K PRIMARY DOCUMENTS one ingestion pass may fetch the TEXT of, so the deterministic
# planned-event extractor has something to read. 0 (the default) keeps SEC EDGAR's request count
# exactly what it was; each unit costs one extra request per filing. Capped at 25.
#
# The extractor never guesses: a filing becomes a Calendar date only when one sentence states a
# scheduling phrase AND exactly one absolute date WITH A YEAR, in the future, inside a bounded
# horizon. Anything else stays evidence. No model is involved.
SEC_BODY_FETCH_LIMIT=0
# Macro providers, both keyless-optional and already read by the gateway.
FRED_API_KEY=
FMP_API_KEY=
# Events-ingestion call allocations. These drive both fail-closed reservations and the Settings
# budget monitor. They do not count gateway/prediction calls; allocate shared provider plans with
# those consumers in mind.
EVENTS_BUDGET_MARKETAUX=80
EVENTS_BUDGET_SEC_EDGAR=500
EVENTS_BUDGET_GOOGLE_NEWS_RSS=250
EVENTS_BUDGET_ALPHAVANTAGE=20
EVENTS_BUDGET_FRED=500
EVENTS_BUDGET_FMP=200
EVENTS_BUDGET_FEDERAL_RESERVE=50
EVENTS_BUDGET_BLS=40
EVENTS_BUDGET_BEA=40
EVENTS_BUDGET_COMPANY_IR=100
# Contact address for the events service's two KEYLESS providers, SEC EDGAR and Google News RSS
# (§9.42, §9.45). Read with NO DEFAULT: absent or blank ⇒ both skip, both skips labelled.
#
# This is the events service's OWN variable and is NOT `SEC_USER_AGENT` (line 39). That line stays
# populated because the gateway needs it — SEC blocks generic user-agents — and compose hands one
# `.env` to every service, so sharing the name meant `cp .env.example .env` silently switched on
# corpus ingestion. Measured, not hypothetical: 60 real articles fetched and stored on a pass
# against an otherwise empty environment.
#
# The gateway's says "identify us to SEC on a per-request fetch". This one says "we are permitted
# to build a PERSISTENT, CROSS-USER CORPUS from keyless sources" — the D-29 posture, a materially
# higher bar. Set it only when you mean that. SETTING IT ENABLES BOTH PROVIDERS.
EVENTS_CONTACT_UA=

# Manual ingestion (make ingest-once). Empty = every provider and baseline + followed tickers.
# A non-empty INGEST_TICKERS is an exact operator override and does not consult Journal.
INGEST_PROVIDERS=
INGEST_TICKERS=

# --- Social sentiment (gateway) ---
# StockTwits crowd sentiment — free, NO key. DESCRIPTIVE crowd color only (NOT a buy/sell signal;
# extremes can be contrarian). Unofficial public endpoint → cached hard, fails silently. Set
# STOCKTWITS_ENABLED=false to disable the source entirely.
STOCKTWITS_ENABLED=true
STOCKTWITS_BASE=https://api.stocktwits.com/api/2

# --- AI Market Brief (gateway → llm) ---
# The gateway assembles the day's ALREADY-COLLECTED facts (price, regime, news, filings, earnings,
# sentiment) and the llm service reads + compresses them into a plain-language digest. AI SYNTHESIS,
# grounded in those facts, descriptive — NEVER a prediction or buy/sell signal. Reuses LLM_* config.
# BRIEF_TTL caches each brief (Go duration, e.g. 30m). Optional.
BRIEF_TTL=30m

# --- AI assistant + chat (gateway → llm) ---
# Beside the Directional Signal: a grounded situational note, a COMPUTED expected-close volatility
# range (from the analysis service — NOT the LLM, NOT a prediction), and grounded chat. Uncertainty
# language, not financial advice — decisions/risk are the user's. ASSISTANT_TTL caches the note (Go
# duration, e.g. 90s); chat is never cached. Reuses LLM_* config. Optional.
ASSISTANT_TTL=90s

# --- Tickers (gateway) ---
TICKERS=NVDA,GOOGL,TSLA

# --- Health probes (gateway) ---
# GET /health is LIVENESS: always 200 while the gateway can serve, with a per-dependency block
#   naming anything that is down (and, for a signed-in operator, why). Point the platform's
#   liveness probe here.
# GET /ready  is READINESS: 503 when one of the upstreams below is down. Point the platform's
#   readiness probe here — and NOT liveness, or a database outage restart-loops a healthy gateway.
# READY_REQUIRE defaults to the two PostgreSQL-backed services, which cannot answer a single real
# query without the database. `llm` is deliberately excluded: invariant #1b makes `stub:offline` a
# shipped shape, not an outage.
READY_REQUIRE=analysis,events

# --- Offline edge-evaluation harness (prediction service, Stage-1 go/no-go) ---
# Batch CLI that answers "does the model have a REAL edge?" with EDGE / NO EDGE / INCONCLUSIVE.
# Research-only, NO buy/sell output, no money. REFUSES a verdict on synthetic/no-network data.
#   docker compose run --rm prediction python -m app.evaluate     (or from repo root: make evaluate)
# Long-running; shrink EVAL_UNIVERSE / EVAL_PERMUTATIONS / EVAL_HISTORY_DAYS for a quick pass.
EVAL_UNIVERSE=NVDA,GOOGL,TSLA,AAPL,MSFT,AMZN,META,AMD,AVGO,NFLX,JPM,V,MA,COST,PEP,KO,XOM,CVX,UNH,JNJ,WMT,HD,PG,DIS,BA,CAT,CRM,ORCL,ADBE,QCOM
EVAL_TIMEFRAME=1D
EVAL_HORIZONS=5,10
EVAL_HISTORY_DAYS=3650
EVAL_HOLDOUT_FRAC=0.2
EVAL_COST_BPS=6
EVAL_PERMUTATIONS=300
EVAL_MIN_TRADES=100
EVAL_SEED=42

# --- Autonomous immutable challenger qualification ---------------------------------------------
# OFF by default. When enabled, a separate production process reacts only after the configured
# number of NEW COMPLETED REAL bars, creates one immutable challenger per config, and starts the
# existing parameter-free price evaluator once for the batch. It never promotes, rolls back, tunes
# thresholds, calls Qwen, or starts/resets the official paper experiment.
PREDICTION_AUTOMATION_ENABLED=false
# Empty uses PAPER_CONFIGS, then the narrow NVDA/GOOGL 1D:H5 fallback.
PREDICTION_AUTOMATION_CONFIGS=
PREDICTION_AUTOMATION_POLL_SECONDS=300
PREDICTION_AUTOMATION_LEASE_SECONDS=600
PREDICTION_AUTOMATION_MIN_NEW_BARS=5
# Fixed trial budget prevents an endless fit/evaluate loop against the same historical corpus.
PREDICTION_AUTOMATION_MAX_TRIALS=3
PREDICTION_AUTOMATION_LOOKBACK_DAYS=1500
# Prospective candidate/champion comparisons stay UNMEASURED below this paired future-bar count.
PREDICTION_SHADOW_MIN_PAIRED_BARS=20

# SAMPLE SUFFICIENCY (portfolio-v3). Floors on how much evidence a verdict may be made on. Each of
# them can only ever produce INCONCLUSIVE — none is a route to EDGE — and none is part of
# `strategy_version()`: they change what a verdict is judged SUFFICIENT ON, not what was traded.
# Tickers that failed to fetch or were skipped for too little history count AGAINST coverage and are
# NAMED in the checklist, so a verdict from a shrunken cohort says so on its face.
EVAL_MIN_DATES=252            # portfolio observation dates (a trading year) in the pooled OOS span
EVAL_MIN_HOLDOUT_DATES=60     # dates in the untouched holdout no fold trained on
EVAL_MIN_TICKERS=10           # evaluated streams at a horizon; a handful of names is not a universe
EVAL_MIN_COVERAGE=0.7         # evaluated / configured tickers

# --- Evaluator ADMINS (gateway: price, PEAD, and forward-estimate manual run endpoints) ---
# The harnesses and estimate collector are reachable FROM THE APP (Settings -> Preferences),
# because the single-container production deploy has no shell and no docker access — without an
# in-app trigger a verdict cannot be produced there at all.
#
# Comma-separated AUTH USER IDS (GET /auth/me -> user.id) — NEVER email addresses — allowed to START
# a run. EMPTY (the default) means NOBODY may start one: starting a minutes-long, CPU-heavy job that
# slows /predict for everyone must not be an anonymous or any-user action on a public box. This is
# the same fail-closed shape as FEEDBACK_ADMIN_UIDS (D-16). GET /api/evaluate/status needs only a
# signed-in session.
#
# The run takes NO PARAMETERS, deliberately: it uses the EVAL_* values above, so every verdict it
# mints carries this deployment's own strategy version and can never be a custom-parameter run
# masquerading as the default strategy (docs/PAPER_EXECUTION_CONTRACT.md §4.3).
EVAL_ADMIN_UIDS=

# --- Offline EVENT-STUDY harness (prediction service, post-earnings drift / PEAD) ---
# Same honesty as the price harness (real-only, no look-ahead, costs, date-holdout, clustered null,
# abnormal-return baseline, verdict). Research-only; no buy/sell or money.
#   docker compose run --rm prediction python -m app.evaluate_events     (or: make evaluate-events)
# Earnings history from Alpha Vantage EARNINGS needs ALPHAVANTAGE_API_KEY (~25 req/day). Production
# persists raw provider payloads + provenance in prediction.earnings_payloads; files are a local
# no-database fallback/import only. Without a key AND stored history → refusal.
EVENT_UNIVERSE=NVDA,GOOGL,TSLA,AAPL,MSFT,AMZN,META,AMD,AVGO,NFLX,JPM,V,MA,COST,PEP,KO,XOM,CVX,UNH,JNJ,WMT,HD,PG,DIS,BA,CAT,CRM,ORCL,ADBE,QCOM
EVENT_TIMEFRAME=1D
EVENT_HISTORY_DAYS=3650
EVENT_HORIZONS=10,20
EVENT_SUE_QUANTILE=0.33
EVENT_MIN=100
EVENT_COST_BPS=6
EVENT_PERMUTATIONS=300
EVENT_HOLDOUT_FRAC=0.2
EVENT_SEED=42
EVENT_BENCHMARK=SPY
EVENT_MIN_DATES=252
EVENT_MIN_HOLDOUT_DATES=60
EVENT_MIN_TICKERS=10
EVENT_MIN_COVERAGE=0.7
# Bounded forward-only estimate collector. Historical estimatedEPS stays descriptive permanently;
# no environment flag can promote it into verified evidence.
ESTIMATE_SNAPSHOT_MAX_CALLS=20
ESTIMATE_ACTUAL_LOOKBACK_DAYS=7
# Baseline PEAD first. AI is a separate marginal-value test over durable forward event-time text.
EVENT_ENABLE_AI=false

# --- The A–F ablation ladder (prediction service, `make ablate`) — Wave 5A ---------------------
# ABLATE_CUTOFFS has NO DEFAULT and the ladder refuses to run without it: every rung must run
# against the IDENTICAL cutoff set (§5.1), and a default set would silently differ between two runs.
# Comma-separated RFC3339 timestamps.
ABLATE_CUTOFFS=
ABLATE_UNIVERSE=NVDA
# A is not built (needs a VL model). B–F are runnable as of Wave 5A; F's breadth and implied-vol
# dimensions are null in this deployment and a bundle whose market/sector class is entirely null is
# refused rather than reported as F.
ABLATE_RUNGS=B,C,D,E
# The split being SCORED, and the (different) split the calibration is FITTED on. Equal values mean
# no calibration is applied — scoring the fit split recovers the training frequencies and measures
# nothing, so it is refused rather than warned about.
ABLATE_SPLIT=dev
ABLATE_CALIBRATION_SPLIT=dev
ABLATE_MIN_SAMPLES=30
ABLATE_COST_BPS=6
# The ladder REFUSES to produce a verdict against `stub:offline` — a ladder measured against a
# fixture licenses the `direction` word (§9.20) on nothing. Setting this to `false` runs the
# plumbing only and can never produce a verdict a direction word may be gated on.
ABLATE_REQUIRE_REAL_RUNTIME=true
# One analyst run can contain several sequential local-model generations. This timeout applies to
# the batch client's whole HTTP request, not to an individual generation.
ABLATE_ANALYST_TIMEOUT=600

# --- The served ablation verdict (llm service) — §9.61 ------------------------------------------
# The ladder writes the verdict; the llm service SERVES it, stamped onto each §7 object as
# `ablationVerdict`, because §9.20's gate is applied in the browser and the path is on the server.
# ABLATION_RUNG has NO DEFAULT: a defaulted rung would match a verdict earned by a different input
# bundle. Unset ⇒ nothing is served and the gate stays closed, which is the correct and ordinary
# state until the ladder has run against a real model.
ABLATION_RUNG=

# --- Model runtime (llm service :8002) — Wave 5C -----------------------------------------------
# THE SELF-HOSTED, KEYLESS MODEL RUNTIME. This is the entry to set on a prod box, and it is TRIED
# FIRST, ahead of every legacy variable below.
#
# IT HAS NO DEFAULT, AND THAT IS THE POINT. Unset ⇒ the llm service serves `stub:offline`
# explicitly and says so on /health (`runtime.refusals`). It never falls back to a localhost
# address, because a run that reached some other machine's model must never be mistakable, after
# the fact, for a run the deterministic stub answered. Shipped EMPTY, like every other gate (§9.42)
# — a populated example is how invariant #1 was violated once already.
#
# THERE IS NO KEY VARIABLE HERE, deliberately. The runtime is keyless; a runtime that requires a
# credential is a change to invariant #1 and needs its own amendment, not a line in this file.
# Setting MODEL_RUNTIME_API_KEY is REFUSED rather than ignored.
#
#   MODEL_RUNTIME_URL=http://model-host:8000        # openai dialect; /v1 added if you omit it
#   MODEL_RUNTIME_MODEL=qwen3-14b                   # required whenever the URL is set
#   MODEL_RUNTIME_KIND=openai                       # openai | ollama
#   MODEL_RUNTIME_NAME=prod-a                       # optional label; defaults to kind@host
MODEL_RUNTIME_URL=
MODEL_RUNTIME_MODEL=
MODEL_RUNTIME_KIND=
MODEL_RUNTIME_NAME=
# Declared quantization of the served weights (q8_0, awq-int4, bf16). The server does not report
# it, so it is declared; it lands in the seven-key `identity` stamp (§9.40).
AI_QUANTIZATION=

# --- LLM read, legacy provider chain (llm service) ---
# ollama (daemon) or openai (LM Studio / any OpenAI-compatible server, keep its app open)
# A managed OpenAI-compatible endpoint (free Qwen). Often auto-injected by the host platform; set locally only
# if you want the same model. Tried after MODEL_RUNTIME_* above; LLM_* below is the last fallback.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=qwen3-14b
# FALLBACK backend (used if AI_* is unset/unreachable). Every BASE URL below ships empty and has no
# code-side default either: unset ⇒ that provider is not in the chain at all.
LLM_BACKEND=ollama
LLM_MODEL=qwen2.5:7b
# For LM Studio in Docker: LLM_BACKEND=openai and LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_BASE_URL=
LLM_API_KEY=
# For Ollama in Docker: OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b

# --- Accounts (auth service :8099 + shared session verification) ---
# The auth service issues an HMAC-signed session cookie that gateway / journal / alerts / feedback /
# llm verify LOCALLY with the SAME AUTH_SECRET (no network hop — all localhost ports are the same
# site, so one httpOnly cookie covers them). Accounts only SCOPE user data (personas, journal, theses,
# alert rules, feedback); they unlock NO trading action. The whole stack still runs with ZERO keys /
# ZERO network.
#
# Set a long random value before exposing beyond localhost. When unset a dev default is used and the
# auth service logs a WARNING. This ONE value must be identical across all services (docker-compose
# wires it from here to each).
AUTH_SECRET=dev-insecure-change-me
# File fallback and one-time pre-PostgreSQL import location. Production accounts/preferences use
# AUTH_DATABASE_URL or DATABASE_URL.
USERS_DIR=/data/auth
# Google OAuth is DEFERRED. Leave EMPTY for the offline demo: the "Continue with Google" button shows
# a "coming soon" toast and /auth/google returns 501. Setting a client id later wires the real flow —
# the only place the app would then need network + a secret.
GOOGLE_CLIENT_ID=
# Frontend base URL for the auth service (the web app calls it directly with credentials).
VITE_AUTH_URL=http://localhost:8099
# The session cookie's name. One value, shared by every service that verifies it.
COOKIE_NAME=nvda_session
# Sessions ride in a cookie, so services the browser calls directly (auth, journal, alerts, feedback)
# reflect an EXACT allow-listed Origin with credentials — never "*". List every web origin you serve.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Feedback admins (feedback service :8098, D-16) ---
# Comma-separated AUTH USER IDS (GET /auth/me -> user.id) — NEVER email addresses — allowed to read
# every tester's submission, read the summary, triage and delete. EMPTY (the default) means NOBODY is
# an admin: those routes fail closed for everyone, while signed-in testers can still submit and read
# their own feedback. Set at least one id before running a real beta, and keep port 8098
# network-restricted regardless — app-level authorization is the boundary, network isolation is
# defence in depth on top of it.
FEEDBACK_ADMIN_UIDS=

# --- Paper-trading validation engine (paper service :8097) --------------------------------------
# The engine runs the validated signal as a PER-BAR ALLOCATION RULE — the same rule the walk-forward
# backtest scores — and is FAIL-CLOSED behind four gates. See docs/PAPER_EXECUTION_CONTRACT.md; it is
# the normative statement both this engine and services/prediction are held to.
# SIMULATION ONLY: no order execution, no broker, no money movement, ever.
#
# Which (ticker:timeframe:horizon) configs to paper. HORIZON IS NOT A HOLDING PERIOD — it names the
# model's LABEL horizon and selects which trained record /predict serves. A position is re-decided
# every bar and closes when the target changes; there is no scheduled exit.
PAPER_CONFIGS=NVDA:1D:5,GOOGL:1D:5,TSLA:1D:5
# How often the engine POLLS for a new bar. This is not a decision rate: it decides at most once per
# trading session, however fast you poll. (The prediction service is LightGBM — polling it is fine.
# Nothing here ever calls the model runtime; invariant #4 stands.)
PAPER_EVAL_INTERVAL=5m
# The simulated book's opening balance (contract §5.2). FAKE MONEY — no account, no broker, no
# withdrawable balance. Positions are sized equity/N (equal-weight 1/N across the enabled configs,
# mirroring the evaluator's portfolio), so the live book and the offline evaluation keep score the
# same way and their Sharpes are finally the same kind of number. Returns are scale-free: this value
# changes no statistic the service reports.
PAPER_STARTING_CASH=100000
# TESTING/DEMO ONLY — REDEFINED. This is no longer a bar LENGTH (it used to be, and for 1D it counted
# CALENDAR days, so Saturdays were bars). Bar identity now comes from the analysis service's own bar
# timestamps. When > 0, every EVAL_INTERVAL tick is counted as a new bar so a demo can fast-forward.
# 0 is the default and the only correct production value.
PAPER_BAR_SECONDS=0
# Freshness gate (contract §4, gate 2). The engine refuses to open or flip when the newest bar is
# more than this many sessions behind today, or when the model's `dataThrough` is more than
# PAPER_MAX_MODEL_AGE_SESSIONS sessions behind that bar. Sessions are approximated by counting
# WEEKDAYS, which over-counts across holidays — i.e. it calls data stale slightly early, on purpose.
PAPER_MAX_BAR_AGE_SESSIONS=3
PAPER_MAX_MODEL_AGE_SESSIONS=10
# The dedicated SYSTEM user the engine records its simulated trades as (D-20 interim (a)). Never a
# person's id: this book belongs to the platform's validation harness and the UI must label it so.
# The engine signs its session with the shared AUTH_SECRET above; the paper service ALSO verifies
# that cookie on its two MUTATING routes (POST /paper/reset, POST /paper/config), which return 403
# naming AUTH_SECRET when none is configured. GET routes stay public.
PAPER_SYSTEM_UID=paper-engine
# Exact allow-list of browser origins for those two MUTATING routes, comma-separated. EMPTY BY
# DEFAULT = no CORS headers at all, which is correct for a service reached same-origin in every
# shipped deployment. It replaces `Access-Control-Allow-Origin: *`, which browsers forbid alongside
# credentials — the wildcard advertised access the authenticated POSTs could never be given.
PAPER_CORS_ORIGINS=
# The engine ALSO requires a persisted evaluator verdict of EDGE for the current strategy version
# (contract §4.3) — matched against the SERVED RECORD'S own thresholds/cost/allowShort, and judged
# per label horizon — written by `python -m app.evaluate` into {EVAL_OUT_DIR}/verdicts/. There is
# deliberately NO variable to bypass it: no EDGE verdict exists today, so the engine trades nothing
# and reports which gate refused, per config, at GET /paper/status. Producing one is an OPERATOR
# action on real data — never a hand-written file.
