# Tester-feedback microservice configuration. Every value has a working default — the service runs
# with ZERO config, ZERO keys and ZERO network. It records tester submissions and nothing else: it
# executes no trade and gives no advice.

PORT=8098

# PostgreSQL is authoritative when this URL (or DATABASE_URL) is set. FEEDBACK_DIR is the explicit
# local fallback and one-time import location for feedback.json.
FEEDBACK_DATABASE_URL=
FEEDBACK_DATABASE_SCHEMA=feedback
FEEDBACK_DIR=./data/feedback

# --- Access control (D-16) ---
# Submissions are user-owned and may contain personal data, so every route except GET /health needs a
# signed-in session. This service verifies the SAME httpOnly cookie the auth service issues, LOCALLY,
# with the SAME AUTH_SECRET — there is no network call from feedback to auth.

# MUST be byte-identical to the value set on auth / gateway / journal / alerts. If it differs, every
# request here reads as a guest and returns 401. Set a long random value before exposing beyond
# localhost.
AUTH_SECRET=dev-insecure-change-me

# MUST match the cookie name the auth service sets (and that journal/alerts read).
COOKIE_NAME=nvda_session

# Sessions ride in a cookie, so CORS reflects an EXACT allow-listed Origin with credentials — never
# "*", which browsers reject alongside credentials anyway. List every web origin that calls :8098
# directly. An origin that is not listed gets no CORS headers at all.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Comma-separated list of AUTH USER IDS — the opaque ids the auth service issues (GET /auth/me ->
# user.id), NEVER email addresses — allowed to:
#   * GET  /feedback          read EVERY submission, including legacy records that predate ownership
#   * GET  /feedback/summary  read the aggregate counts
#   * PATCH/DELETE /feedback/{id}   triage and delete
#
# EMPTY (the default) MEANS NOBODY IS AN ADMIN: those four routes fail closed with 403 for every
# signed-in caller, and the service logs a warning at startup. It still starts, and authenticated
# testers can still submit and read their own submissions.
#
# This is deliberately not a role system in `auth` — for a closed beta an allow-list of ids is the
# whole requirement. Authorization is derived from the verified session cookie alone: no header,
# query parameter, request body or browser flag can grant it.
#
# Production: set at least one admin uid, AND keep port 8098 network-restricted. App-level
# authorization is the boundary; network isolation is defence in depth on top of it.
FEEDBACK_ADMIN_UIDS=
