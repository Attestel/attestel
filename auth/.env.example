# Accounts microservice (:8099) — local user store + HMAC-signed session cookies. Standard-library
# Go, no external modules. The whole stack still runs with ZERO keys / ZERO network.

PORT=8099
# Where users.json lives. docker-compose mounts a `users:` volume here.
USERS_DIR=./data/auth

# HMAC signing key for session tokens. MUST be the SAME value on gateway, journal, alerts and the
# llm service so every service verifies the same cookie. A dev default is used when unset (the
# service logs a WARNING) — set a long random value before exposing beyond localhost.
AUTH_SECRET=dev-insecure-change-me

# Session lifetimes (Go durations). SESSION_TTL is the default; REMEMBER_TTL is "keep me signed in".
SESSION_TTL=12h
REMEMBER_TTL=720h

# Cookie name + the exact CORS allow-list (cookies => no wildcard). Add your prod web origin here.
COOKIE_NAME=nvda_session
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Google OAuth 2.0 (Authorization Code flow, stdlib-only). DEFERRED until BOTH the client id and
# secret are set: while either is empty the Google button shows a "coming soon" toast and the
# /auth/google endpoints return 501 — the offline demo needs no network.
#
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID -> Web application:
#   Authorized JavaScript origins:  http://localhost:5173        (your web origin; add prod too)
#   Authorized redirect URIs:       http://localhost:8099/auth/google/callback
#     ^ MUST equal GOOGLE_REDIRECT_URL below BYTE-FOR-BYTE (scheme, host, port, path — no trailing /).
#   OAuth consent screen scopes:    openid, email, profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8099/auth/google/callback
# Where to send the browser after login (success -> APP_URL#<view>, failure -> APP_URL?authError=1).
# Defaults to the first CORS origin when unset.
APP_URL=http://localhost:5173
