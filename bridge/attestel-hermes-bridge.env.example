# attestel-hermes-bridge — LOCAL configuration template.
#
# ─────────────────────────────────────────────────────────────────────────────────────────────
# THIS FILE IS A TEMPLATE OF PLACEHOLDERS AND IS COMMITTED. THE FILE YOU FILL IN IS NOT.
#
# Copy it OUTSIDE this repository (or to a path the ignore rules cover), fill it in, and chmod it
# 0600. Every value below is a placeholder in angle brackets; none of them is a real credential and
# none of them may become one in this file.
#
#     cp bridge/attestel-hermes-bridge.env.example ~/.config/attestel-hermes-bridge/env
#     chmod 600 ~/.config/attestel-hermes-bridge/env
#     set -a; . ~/.config/attestel-hermes-bridge/env; set +a
#     attestel-hermes-bridge -check
# ─────────────────────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────────────────────

# Where the hosted Attestel deployment serves the JOURNAL. HTTPS is required. The bridge refuses
# plain http to anything but a loopback host, and only then with ATTESTEL_ALLOW_INSECURE_URL=1 —
# this connection carries a bearer credential.
#
# IT MUST INCLUDE THE REVERSE-PROXY PREFIX, and getting this wrong is the most likely first-run
# failure. In the shipped deployment (deploy/nginx.conf.template) the journal is NOT exposed on its
# own port; it is served under `/svc/journal/`, while `/api/` goes to the gateway. The bridge
# appends `/_internal/agency/...` to whatever you set here, so a bare host would post every claim to
# a path the gateway serves and the journal never sees.
#
#   production (behind the shipped nginx):  https://<your-attestel-host>/svc/journal
#   local development (journal direct):     http://localhost:8096
#
# `attestel-hermes-bridge -check` verifies this end to end before any job is claimed.
ATTESTEL_URL=https://<your-attestel-host>/svc/journal

# The worker credential. It must equal AGENCY_WORKER_TOKEN on the hosted side.
#
# GENERATE A NEW ONE; DO NOT REUSE AUTH_SECRET. AUTH_SECRET signs session cookies, so a credential
# that lives on a laptop and can be turned into a session for an arbitrary user is a credential
# whose compromise is an account compromise. Generate 32 bytes:
#
#     openssl rand -hex 32 | tr -d '\n' > <path>     # NO trailing newline
#
# The `tr -d` matters: `openssl rand -hex 32` appends a newline, and a platform that sets the hosted
# secret from that file verbatim would store a value one byte longer than the one the bridge sends.
# The journal now trims its configured token as well, so both halves are protected — but generating
# it clean keeps the two values genuinely identical.
#
# Prefer the FILE form on a shared or long-lived machine: an environment variable is visible in
# `ps e` and in any shell history that exported it, while a 0600 file is not. The bridge refuses a
# credential file that is group- or world-readable, and it removes the variable from its own
# environment as soon as it reads it so the Hermes child processes never inherit it.
ATTESTEL_WORKER_TOKEN=<WORKER_TOKEN>
# ATTESTEL_WORKER_TOKEN_FILE=<path to a 0600 file containing only the token>

# ── PROFILE WRAPPERS ─────────────────────────────────────────────────────────────────────────
#
# `hermes chat` has no --profile flag. The two mechanisms are a sticky global default
# (`hermes profile use`, which is mutable global state and wrong for a worker) and per-profile
# wrapper scripts. The bridge takes the wrapper, so the profile is part of the executable NAME and
# a hosted job cannot name one.
#
# THE FOUR PROFILES MUST EXIST FIRST, and each must have a working model configured. This bridge
# never sets -m/--provider and never reads your Hermes configuration: which model answers is yours
# to decide, per profile, and it is not expressible over the wire. Create or import the profiles
# with `hermes profile create` / `hermes profile install` before aliasing them.
#
# Then create the four wrappers once:
#
#     hermes profile alias stock-scout
#     hermes profile alias stock-fundamentals
#     hermes profile alias stock-risk
#     hermes profile alias stock-chair
#
# `hermes profile alias --help`: "--name NAME  Custom alias name (default: profile name)". So the
# wrapper that command creates is named after the PROFILE — `stock-scout`, not `hermes-stock-scout`.
# The bridge looks for `<profile>` on PATH first, then `hermes-<profile>` for anyone who chose that
# with --name. Override an individual one only if your wrapper is somewhere else:
# ATTESTEL_HERMES_BIN_STOCK_SCOUT=<path to the stock-scout wrapper>
# ATTESTEL_HERMES_BIN_STOCK_FUNDAMENTALS=<path to the stock-fundamentals wrapper>
# ATTESTEL_HERMES_BIN_STOCK_RISK=<path to the stock-risk wrapper>
# ATTESTEL_HERMES_BIN_STOCK_CHAIR=<path to the stock-chair wrapper>

# ── BOUNDS (defaults shown; lower them freely, they are ceilings) ─────────────────────────────

# Wall-clock budget for ONE Hermes stage, in seconds. Passed to Hermes as --run-budget AND enforced
# locally with a hard deadline: a budget the child honours voluntarily is not a bound.
# ATTESTEL_STAGE_BUDGET_SECONDS=600

# Wall-clock budget for the whole four-stage workflow, in seconds.
#
# THE BRIDGE REFUSES TO START unless this is at least (4 x stage budget) + 300 seconds. Four stages
# of 600s is 2400s of stages alone; the extra 300s is the four heartbeat round trips, the four JSON
# decodes and schema validations, the source-table merge, the artifact assembly, the content scans
# and the upload. At exactly 2400 a run whose stages each used their budget would finish the
# artifact and have no time left to send it.
# ATTESTEL_RUN_BUDGET_SECONDS=2700

# Tool-calling iterations per stage. Hermes' own default is 500, which is an interactive default.
# This value can only LOWER a stage's declared cap, never raise it.
# ATTESTEL_MAX_TURNS=24

# How long a lease the bridge asks for, in seconds. The server clamps it to its own 1800s ceiling.
#
# THE BRIDGE REFUSES TO START unless this is at least the stage budget PLUS 120 seconds. It
# heartbeats BETWEEN stages, not during one, so a lease that does not outlast a whole stage expires
# at the moment that stage finishes: the run is taken over, the upload is refused with a 409, and
# the work is thrown away. Raise the stage budget and this must go up with it.
# ATTESTEL_LEASE_SECONDS=900

# ── LOCAL PATHS ──────────────────────────────────────────────────────────────────────────────

# Where the opaque worker id and the per-run scratch directories live. Created 0700. Nothing in it
# is ever uploaded, and the scratch directories are deleted at the end of every run.
# ATTESTEL_BRIDGE_STATE_DIR=<a private directory you own>

# Override the four stage prompt templates. They are embedded in the binary; this is for editing
# them locally. A missing directory falls back to the embedded copies rather than failing.
# ATTESTEL_BRIDGE_PROMPT_DIR=<a directory containing stock-*.md>

# ── DEVELOPMENT ONLY ─────────────────────────────────────────────────────────────────────────

# Permit http:// — accepted ONLY for localhost/127.0.0.1/::1, and refused for any other host even
# when this is set.
# ATTESTEL_ALLOW_INSECURE_URL=1

# Replace the four Hermes invocations with a deterministic local stub. Use it to prove the whole
# pipe works — credential, URL, routes, schema, validation, UI — before spending a model call on
# debugging authentication. Every artifact a dry run produces is labelled `degraded`, so it can
# never be mistaken for real research.
# ATTESTEL_BRIDGE_DRY_RUN=1
