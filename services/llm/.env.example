# --- PRIMARY: the self-hosted, KEYLESS model runtime (Wave 5C) --------------------------------
# Tried FIRST, ahead of everything below. Read with NO DEFAULT: unset ⇒ this service serves
# `stub:offline` explicitly and reports the reason at /health under `runtime.refusals`. It never
# falls back to localhost, so a run that reached a model and a run the stub answered can never be
# confused after the fact. Shipped EMPTY (§9.42's rule, applied to the endpoint).
#
# There is NO key variable for this runtime. It is keyless by contract; setting
# MODEL_RUNTIME_API_KEY is refused rather than ignored.
MODEL_RUNTIME_URL=
MODEL_RUNTIME_MODEL=
# openai | ollama. Blank ⇒ openai (a dialect, not an address — defaulting it opens no socket).
MODEL_RUNTIME_KIND=
# Optional label for this deployment; blank ⇒ kind@host.
MODEL_RUNTIME_NAME=
# Declared quantization of the served weights (q8_0 | awq-int4 | bf16 | ...). Not derivable from
# the server, so it is declared; it lands in the seven-key `identity` stamp (§9.40).
AI_QUANTIZATION=

# --- LEGACY: managed model (OpenAI-compatible, free Qwen) -----------------
# On a managed platform these are injected into the pod automatically — leave blank locally unless you want to
# hit the same endpoint. When AI_BASE_URL + AI_API_KEY are set they are tried FIRST; the LLM_*
# backend below becomes the fallback. AI_BASE_URL may be a root (a /v1 suffix is added if missing).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=qwen3-14b

# --- FALLBACK model backend (tried if the managed endpoint is unset/unreachable) -------------
# LLM_BACKEND=ollama  -> Ollama native API (default). Runs as a background daemon.
# LLM_BACKEND=openai  -> any OpenAI-compatible server (a managed Qwen endpoint, LM Studio, ...).
LLM_BACKEND=ollama

# Model name as your server exposes it.
#   ollama:  qwen2.5:7b | qwen3:14b | llama3.1:8b ...
#   openai:  qwen3-14b  (managed) | the model id shown in LM Studio's Developer/server tab
LLM_MODEL=qwen2.5:7b

# Base URL. THERE IS NO DEFAULT — blank means this provider is not in the chain at all, not
# "localhost". Typical values, to be typed deliberately:
#   ollama -> http://localhost:11434        (in Docker: http://host.docker.internal:11434)
#   openai -> http://localhost:1234/v1      (LM Studio)
LLM_BASE_URL=
# LM Studio ignores the key, but some OpenAI-compatible servers require a non-empty one. The openai
# fallback is only added to the chain when BOTH a base and a key are set; a keyless self-hosted
# endpoint belongs in MODEL_RUNTIME_* above, which is what that provider exists for.
LLM_API_KEY=

# (legacy, still honored by the ollama backend — blank, and with no code-side default)
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b
