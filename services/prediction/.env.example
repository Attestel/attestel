# Prediction service configuration. Runs with ZERO config/keys — but a model trained on synthetic
# data is meaningless and is tagged trainedOnSynthetic=true so the UI shows a loud SYNTHETIC banner.

PORT=8003

# Source of the feature matrix (the indicator-enriched frame the UI also shows). Defaults to local
# dev; docker-compose overrides with the in-network hostname (http://analysis:8001).
ANALYSIS_URL=http://localhost:8001

# Where trained models + backtest reports are persisted (per ticker/timeframe/horizon). Volume in
# docker so models survive restarts.
MODELS_DIR=./data/models

# Optional Chronos "expected path" overlay (a prior, never a signal). OFF by default; the core
# LightGBM signal never depends on it, and it must never be loaded alongside qwen (16 GB budget).
ENABLE_CHRONOS=false

# Backtest transaction-cost assumptions, in basis points, charged on every position change.
COMMISSION_BPS=1.0
SLIPPAGE_BPS=5.0

# ── Offline edge-evaluation harness (app/evaluate.py) ────────────────────────
# The Stage-1 test: does the model have a REAL edge? A batch CLI (research-only, NO buy/sell output,
# no money). It REFUSES a verdict on synthetic/no-network data. Run it AFTER the analysis service is
# serving real prices:  cd services/prediction && python -m app.evaluate   (or: make evaluate).
# It is long-running (universe x horizons x walk-forward folds x permutations). For a quick smoke
# pass, shrink EVAL_UNIVERSE / EVAL_PERMUTATIONS / EVAL_HISTORY_DAYS.
#
# Universe of liquid large caps to POOL trades over — a single ticker can't answer "is there an edge".
EVAL_UNIVERSE=NVDA,GOOGL,TSLA,AAPL,MSFT,AMZN,META,AMD,AVGO,NFLX,JPM,V,MA,COST,PEP,KO,XOM,CVX,UNH,JNJ,WMT,HD,PG,DIS,BA,CAT,CRM,ORCL,ADBE,QCOM
EVAL_TIMEFRAME=1D
EVAL_HORIZONS=5,10
EVAL_HISTORY_DAYS=3650
EVAL_HOLDOUT_FRAC=0.2
# Cost per position change, in basis points. Defaults to COMMISSION_BPS + SLIPPAGE_BPS.
EVAL_COST_BPS=6
# Permutations for the null (random-timing) control. 300 is a reasonable default; drop to ~100 quick.
EVAL_PERMUTATIONS=300
# Minimum pooled out-of-sample trades required to render a verdict (else INCONCLUSIVE).
EVAL_MIN_TRADES=100
# Fixed seed so the permutation p-value is reproducible.
EVAL_SEED=42
# Where report-<UTCstamp>.{md,json} are written.
EVAL_OUT_DIR=./data/eval

# ── Autonomous immutable challenger qualification ────────────────────────────
# Requires PostgreSQL and a separately supervised `python -m app.autonomy` process. The timer only
# checks for completed real bars. Promotion and paper reset remain manual-only.
PREDICTION_AUTOMATION_ENABLED=false
PREDICTION_AUTOMATION_CONFIGS=NVDA:1D:5,GOOGL:1D:5
PREDICTION_AUTOMATION_BASE_URL=http://localhost:8003
PREDICTION_AUTOMATION_POLL_SECONDS=300
PREDICTION_AUTOMATION_LEASE_SECONDS=600
PREDICTION_AUTOMATION_MIN_NEW_BARS=5
PREDICTION_AUTOMATION_MAX_TRIALS=3
PREDICTION_AUTOMATION_LOOKBACK_DAYS=1500
PREDICTION_SHADOW_MIN_PAIRED_BARS=20

# ── Offline EVENT-STUDY harness (app/evaluate_events.py) ─────────────────────
# Tests post-earnings drift (PEAD) with the same honesty as the price harness: real-data-only, no
# look-ahead (entry = open of the first session AFTER reportedDate), costs, untouched date-holdout,
# clustered timing null, abnormal-return baseline, verdict + report. Research-only; no buy/sell, no money.
#   cd services/prediction && python -m app.evaluate_events   (or: make evaluate-events)
#
# Earnings history comes from Alpha Vantage EARNINGS (needs ALPHAVANTAGE_API_KEY, ~25 req/day).
# Production stores immutable payload revisions + provenance in PostgreSQL; local files remain a
# no-database fallback/import. Without a key AND stored payload, the harness refuses.
# NOTE: prices come from analysis /features, whose 1D yfinance window is ~2y, so the study covers ~2y
# of earnings unless a longer-history price provider (e.g. Tiingo) is configured in the analysis service.
#
# Universe defaults to EVAL_UNIVERSE. Broadening it (and adding smaller caps) is a FAIRER test —
# drift is weaker in heavily-covered mega-caps. Results are on SURVIVORS only (survivorship bias).
EVENT_UNIVERSE=NVDA,GOOGL,TSLA,AAPL,MSFT,AMZN,META,AMD,AVGO,NFLX,JPM,V,MA,COST,PEP,KO,XOM,CVX,UNH,JNJ,WMT,HD,PG,DIS,BA,CAT,CRM,ORCL,ADBE,QCOM
EVENT_TIMEFRAME=1D
EVENT_HISTORY_DAYS=3650
EVENT_HORIZONS=10,20
# Trade only STRONG surprises: |SUE| in the top/bottom tercile (0.33). Direction = sign(SUE).
EVENT_SUE_QUANTILE=0.33
# Minimum pooled events required to render a verdict (else INCONCLUSIVE).
EVENT_MIN=100
# Cost per leg, bps (defaults to COMMISSION_BPS + SLIPPAGE_BPS; charged round-trip per event).
EVENT_COST_BPS=6
EVENT_PERMUTATIONS=300
EVENT_HOLDOUT_FRAC=0.2
EVENT_SEED=42
EVENT_BENCHMARK=SPY
EVENT_MIN_DATES=252
EVENT_MIN_HOLDOUT_DATES=60
EVENT_MIN_TICKERS=10
EVENT_MIN_COVERAGE=0.7
# Bounded forward collector. Production runs one pass from Settings -> Preferences -> Forward
# estimate snapshots; local operators may use `python -m app.estimate_snapshots`. One call is
# reserved for the calendar; remaining calls capture exact-period T-7/T-1 consensus or actuals.
# PostgreSQL is required.
ESTIMATE_SNAPSHOT_MAX_CALLS=20
ESTIMATE_ACTUAL_LOOKBACK_DAYS=7
# Test 2 (AI marginal value): score event-time TEXT via the LLM /score-earnings endpoint and ask
# whether AI tone adds value on top of SUE. Historical text is scarce, so it runs on the retrievable
# PostgreSQL subset and ACCUMULATES FORWARD. Disabled until the baseline + forward corpus exist.
EVENT_ENABLE_AI=false
