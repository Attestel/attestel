# ─────────────────────────────────────────────────────────────────────────────
# Global event corpus (events service :8004, D-26).
#
# PostgreSQL is required. Provider keys remain optional: with only DATABASE_URL set, the
# service migrates and serves stored reads without opening a provider socket.
# ─────────────────────────────────────────────────────────────────────────────

# DATABASE_URL is the all-in-one/hosting-platform contract. EVENTS_DATABASE_URL may override it
# when this service is deployed separately.
DATABASE_URL=postgresql://attestel:attestel@localhost:55432/attestel_events
EVENTS_DATABASE_URL=
EVENTS_DATABASE_SCHEMA=public
EVENTS_DB_CONNECT_TIMEOUT=10
EVENTS_DB_STATEMENT_TIMEOUT_MS=15000

# Default/scheduled ingestion merges TICKERS with Journal's aggregate followed-ticker set.
# Empty keeps standalone runs on TICKERS only; an unreachable configured Journal fails soft.
JOURNAL_URL=http://localhost:8096

# D-29 retention, per source tier. `official` is indefinite by policy and has no knob.
RETENTION_PROFESSIONAL_DAYS=400
RETENTION_DISCUSSION_DAYS=90

# D-25: background LLM enrichment. OFF by default; never triggered by a UI event (invariant #4).
EVENT_ENRICH_ENABLED=false
# Ingestion is a batch job, not a page load (§9.31). OFF by default alongside enrichment.
INGEST_ENABLED=false
# Discovery Scout: bounded keyless intake plus deterministic stored research-lead materialization.
SCOUT_INGEST_ENABLED=false
SCOUT_ENABLED=false
SCOUT_UNIVERSE=NVDA,GOOGL,TSLA,AAPL,MSFT,AMZN,META,AMD,AVGO,NFLX,JPM,V,MA,COST,PEP,KO,XOM,CVX,UNH,JNJ,WMT,HD,PG,DIS,BA,CAT,CRM,ORCL,ADBE,QCOM
SCOUT_INTAKE_PROVIDERS=google-news-rss
SCOUT_INTAKE_BATCH_SIZE=5
SCOUT_INTAKE_SLOT_SECONDS=14400
SCOUT_MAX_BAR_AGE_DAYS=7
SCOUT_MAX_RUN_AGE_SECONDS=43200
AUTOMATION_INTERVAL_SCOUT_INTAKE=14400
AUTOMATION_INTERVAL_SCOUT=14400
# All-in-one production clock for the model-free events-owned lanes only. Off by default; the
# ordinary AUTOMATION_ENABLED and lane flags remain mandatory.
PRODUCTION_SCHEDULER_ENABLED=false
PRODUCTION_SCHEDULER_POLL_SECONDS=60
# Direct official FOMC calendar ingestion. OFF by default so an empty environment opens no socket.
FEDERAL_RESERVE_ENABLED=false

# ── Provider gates (EVENT_CONTRACTS.md §9.42) ────────────────────────────────
# All read with no default. Absent or empty ⇒ that provider is skipped, and the skip appears in
# `degraded` exactly like a missing key.
ALPHAVANTAGE_API_KEY=
MARKETAUX_API_KEY=
FRED_API_KEY=
FMP_API_KEY=

# Daily events-ingestion allocations; Settings monitoring is derived from this same ledger.
EVENTS_BUDGET_MARKETAUX=80
EVENTS_BUDGET_SEC_EDGAR=500
EVENTS_BUDGET_GOOGLE_NEWS_RSS=250
EVENTS_BUDGET_ALPHAVANTAGE=20
EVENTS_BUDGET_FRED=500
EVENTS_BUDGET_FMP=200
EVENTS_BUDGET_FEDERAL_RESERVE=50
EVENTS_BUDGET_BLS=40
EVENTS_BUDGET_BEA=40
EVENTS_BUDGET_COMPANY_IR=100

# ONE VARIABLE, TWO PROVIDERS — and it is THIS service's own, not the gateway's (§9.45).
#
# SEC EDGAR needs a real contact user-agent (it blocks generic ones) and Google News RSS needs no
# key at all, so both keyless providers are gated on this one value. Setting it switches on BOTH.
#
# It is deliberately NOT the gateway's `SEC_USER_AGENT`. Compose hands one `.env` to every service
# and the gateway's copy must stay populated, so a shared name could not be both populated there
# and empty here — and `cp .env.example .env` silently enabled corpus ingestion. That is measured,
# not hypothetical: a full pass against an "empty" environment fetched and stored 60 real articles.
#
# The two also mean different things. The gateway's says "identify us to SEC on a per-request
# fetch". This one says "we are permitted to build a PERSISTENT, CROSS-USER CORPUS from keyless
# sources" — the D-29 posture, a materially higher bar that must be opted into explicitly.
#
# Ships EMPTY, and is read with no default: absent or blank ⇒ both providers skip, both skips are
# labelled in `degraded`.
EVENTS_CONTACT_UA=

# Manual ingestion (`make ingest-once`). Empty = every provider and baseline + followed tickers.
# A non-empty INGEST_TICKERS is an exact operator override and does not consult Journal.
INGEST_PROVIDERS=
INGEST_TICKERS=
