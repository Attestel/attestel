# ─────────────────────────────────────────────────────────────────────────────
# Point-in-time bar store. PostgreSQL is required; there is no SQLite/file fallback.
# DATABASE_URL is the all-in-one/hosting-platform contract. BARS_DATABASE_URL may override it when
# analysis is deployed separately.
DATABASE_URL=postgresql://attestel:attestel@localhost:55432/attestel_events
BARS_DATABASE_URL=
BARS_DATABASE_SCHEMA=analysis
BARS_DB_CONNECT_TIMEOUT=10
BARS_DB_STATEMENT_TIMEOUT_MS=15000
INTRADAY_RETENTION_DAYS=90

# ─────────────────────────────────────────────────────────────────────────────
# Price data (analysis service). ALL OPTIONAL — with none set the service uses yfinance (Yahoo, no
# account/key) for REAL prices, and only falls back to synthetic seed data with no network.
# Provider order: Alpaca → Twelve Data → yfinance → Tiingo (1D) → synthetic.
# ─────────────────────────────────────────────────────────────────────────────

# Alpaca Market Data (free "Basic"/IEX) — intraday + daily bars + fresh quote. OPTIONAL and requires
# broker KYC (it's a brokerage). Skip it unless you already have an Alpaca account.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Twelve Data — official API, EMAIL-ONLY signup (no KYC), free 800 req/day, intraday + daily.
# Get a key at https://twelvedata.com. Used only if set; otherwise yfinance (no key) is used.
TWELVEDATA_API_KEY=

# Tiingo (official EOD) — optional daily-only (1D) fallback. Used only if set.
TIINGO_API_KEY=
