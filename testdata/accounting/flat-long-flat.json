{
  "name": "flat-long-flat",
  "description": "One long episode opened from flat and closed back to flat. The reference scenario: its expected numbers are HAND-COMPUTED in `handComputation` below, so neither implementation defines the truth.",
  "inputs": {
    "costBps": 100.0,
    "timeframe": "1D",
    "retNext": [
      0.1,
      0.2,
      -0.1,
      0.05
    ],
    "positions": [
      0.0,
      1.0,
      1.0,
      0.0
    ]
  },
  "expected": {
    "net": [
      0.0,
      0.19,
      -0.1,
      -0.01
    ],
    "equity": [
      1.0,
      1.19,
      1.071,
      1.06029
    ],
    "totalReturn": 0.06029,
    "mean": 0.02,
    "std": 0.10559356041,
    "numTrades": 1,
    "turnover": [
      0.0,
      1.0,
      0.0,
      1.0
    ]
  },
  "tolerance": 1e-09,
  "handComputation": [
    "cost_bps = 100 => 100/10000 = 0.01 charged per unit of |dposition|.",
    "prev      = [0, 0, 1, 1]        (0 before the first bar)",
    "turnover  = [0, 1, 0, 1]        open at t1, close at t3; the HELD bar t2 pays nothing",
    "cost      = [0, 0.01, 0, 0.01]",
    "net[0] = 0*0.10 - 0      =  0.00",
    "net[1] = 1*0.20 - 0.01   =  0.19",
    "net[2] = 1*(-0.10) - 0   = -0.10",
    "net[3] = 0*0.05 - 0.01   = -0.01   <- flat bar still pays the exit's cost",
    "equity = cumprod(1+net):",
    "  1 * 1.00  = 1.0",
    "  1.0 * 1.19 = 1.19",
    "  1.19 * 0.90 = 1.071",
    "  1.071 * 0.99 = 1.06029",
    "totalReturn = 1.06029 - 1 = 0.06029",
    "mean = (0 + 0.19 - 0.10 - 0.01)/4 = 0.08/4 = 0.02",
    "deviations = [-0.02, 0.17, -0.12, -0.03]; squares sum = 0.0446; /4 = 0.01115",
    "std (population, ddof=0) = sqrt(0.01115) = 0.1055935604097...",
    "numTrades = transitions INTO a nonzero position = 1 (only t1)."
  ]
}
