# Base URL of the Go gateway. Leave blank to use the Vite dev proxy (/api -> :8080).
VITE_GATEWAY_URL=

# Base URL of the alerts microservice (separate Go service). Defaults to http://localhost:8095.
# The alerts UI fails silent if this is unreachable, so the dashboard is never affected.
VITE_ALERTS_URL=http://localhost:8095

# Base URL of the trade-journal microservice (separate Go service). Defaults to http://localhost:8096.
# The journal UI fails silent if this is unreachable, so the dashboard is never affected.
VITE_JOURNAL_URL=http://localhost:8096

# Base URL of the paper-trading validation service (separate Go service). Defaults to
# http://localhost:8097. Simulation only; the UI fails silent if it's unreachable.
VITE_PAPER_URL=http://localhost:8097
