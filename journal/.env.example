# Trade-journal microservice configuration. Every value has a working default — the service runs
# with ZERO config and ZERO keys. It is a manual record of your trades: it executes nothing.

PORT=8096

# Upstream signal sources (read-only). Defaults target local dev; docker-compose overrides these
# with the in-network service hostnames (http://analysis:8001 / http://gateway:8080).
# ANALYSIS_URL: used for the current /quote that marks open trades' unrealized P&L.
# GATEWAY_URL:  used to snapshot the dashboard read at entry when captureRead=true.
ANALYSIS_URL=http://localhost:8001
GATEWAY_URL=http://localhost:8080

# PostgreSQL is authoritative when this URL (or DATABASE_URL) is set for trades, research,
# portfolios, onboarding and analytics. TRADES_DIR is the explicit local fallback/import source.
JOURNAL_DATABASE_URL=
JOURNAL_DATABASE_SCHEMA=journal
TRADES_DIR=./data/journal
