PORT=8080
ANALYSIS_URL=http://localhost:8001
LLM_URL=http://localhost:8002
# Directional-signal quant service (LightGBM + walk-forward backtest). The gateway proxies
# /api/predict + /api/train and folds the (backtest-gated) signal into the dashboard.
PREDICTION_URL=http://localhost:8003

# Configurable ticker universe for the frontend switcher (first is the default).
TICKERS=NVDA,GOOGL,TSLA

# Phase 2 live data (optional). Without these, the gateway serves verified seed data instead.
# Alpha Vantage free tier = 25 req/day (only free source of EPS consensus/surprise).
ALPHAVANTAGE_API_KEY=
# Marketaux free tier = 100 req/day (entity-tagged news + sentiment).
MARKETAUX_API_KEY=

# SEC EDGAR needs NO key, but requires a User-Agent with real contact info (they block generic UAs).
# Change the email to yours. 8-K filings are always merged into the news feed.
SEC_USER_AGENT=NVDA-Platform/0.1 (you@example.com)

# StockTwits crowd sentiment — free, NO key. DESCRIPTIVE crowd color only (never a buy/sell signal).
# Unofficial public endpoint (may change / rate-limit), so it's cached hard and fails silently.
STOCKTWITS_ENABLED=true
STOCKTWITS_BASE=https://api.stocktwits.com/api/2
# How long to cache the sentiment summary (Go duration, e.g. 10m). Optional.
SENTIMENT_TTL=10m

# AI Market Brief — the gateway assembles the day's collected facts and the llm service reads +
# compresses them into a plain-language digest (AI synthesis, grounded + non-prescriptive, never a
# signal). How long to cache each brief (Go duration, e.g. 30m). Optional.
BRIEF_TTL=30m

# AI assistant situational note — the gateway assembles the live context (regime/confluence/signal/the
# COMPUTED expected-close range/news/sentiment) and the llm reasons over it. Grounded, non-oracular,
# not financial advice. Cache the note this long (Go duration, e.g. 90s); chat is NEVER cached. Optional.
ASSISTANT_TTL=90s

# --- Accounts (shared session verification) ---
# The gateway verifies the auth service's session cookie LOCALLY with this key (no network hop) to
# forward X-User-Id to the llm and require a user for persona mutations. MUST match the value on
# auth/journal/alerts/llm. A dev default is used when unset.
AUTH_SECRET=dev-insecure-change-me
# Session cookie name — must match the auth service (default nvda_session).
COOKIE_NAME=nvda_session
# Cookies => exact CORS allow-list (no wildcard). Add your prod web origin here.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
