# Alerts microservice configuration. Every value has a working default — the service runs with
# ZERO config and ZERO keys (it still evaluates rules against synthetic data, useful for testing).

PORT=8095

# Upstream signal sources. Defaults target local dev; docker-compose overrides these with the
# in-network service hostnames (http://analysis:8001 / http://gateway:8080).
ANALYSIS_URL=http://localhost:8001
GATEWAY_URL=http://localhost:8080

# Ticker universe evaluated on the schedule (rules can target any ticker regardless).
TICKERS=NVDA,GOOGL,TSLA

# How often the evaluation loop runs (Go duration: 30s, 60s, 5m, …).
EVAL_INTERVAL=60s

# PostgreSQL is authoritative when this URL (or DATABASE_URL) is set. The directory is retained for
# explicit local fallback and one-time import of rules/events/read-state/monitor queue files.
ALERTS_DATABASE_URL=
ALERTS_DATABASE_SCHEMA=alerts
RULES_DIR=./data/alerts

# --- Notifications (ALL optional; the in-app events feed always works without them) ---

# Generic / Slack / Discord-compatible webhook. On each fire we POST JSON that carries
# {ticker,type,timeframe,message,ts} plus `text` (Slack) and `content` (Discord) aliases.
ALERT_WEBHOOK_URL=

# SMTP email delivery (leave SMTP_HOST empty to disable). Auth is used only if SMTP_USER is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
